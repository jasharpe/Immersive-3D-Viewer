{
  "name": "immersive-3d-viewer",
  "version": "0.1.0",
  "description": "Desktop 3D model library viewer with a walkable first-person zoo mode",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "postinstall": "node scripts/vendor-three.js",
    "vendor": "node scripts/vendor-three.js",
    "pack": "electron-builder --dir",
    "smoke": "node scripts/smoke-test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "Immersive 3D Viewer",
  "private": true,
  "build": {
    "appId": "com.jasharpe.immersive3dviewer",
    "productName": "Immersive 3D Viewer",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "Immersive 3D Viewer"
    },
    "directories": {
      "output": "dist"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasharpe/Immersive-3D-Viewer.git"
  }
}
